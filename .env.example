DATABASE_URL="postgresql://refermarket:CHANGE_ME@localhost:5432/refermarket?schema=public"
AUTH_SECRET="GENERATE_A_RANDOM_VALUE_AT_LEAST_32_CHARACTERS"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Referral Market"
APP_ENV="production"
PAYMENT_MODE="manual"
DEMO_SEED="false"
DEMO_BOOTSTRAP_ONCE="false"
# Set DEMO_SEED=true ONLY for an explicitly seeded demo environment.
# Provide DEMO_PASSWORD securely for seed users. Never use a production password.
DEMO_PASSWORD=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Stripe architecture is test-only until payment/compliance readiness is complete.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Evidence is stored privately in PostgreSQL for the MVP (5 MB per file).
MAX_EVIDENCE_BYTES="5242880"
# Only demo/manual adapters are implemented. New referrals use post-verification payments.
PAYMENT_PROVIDER="manual"
# Provider URLs reject external events until a real signature-verified adapter exists.
TARGETED_VERIFICATION_DAYS="30"
MONITOR_CONCURRENCY="2"
MONITOR_DOMAIN_DELAY_MS="1200"
MONITOR_RETRIES="1"
# Hybrid monitoring is disabled for AI/search unless provider credentials are explicitly supplied.
# AI adapter: any compatible chat-completions endpoint returning JSON (not private user evidence).
MONITOR_AI_PROVIDER=""
MONITOR_AI_API_KEY=""
MONITOR_AI_ENDPOINT="https://api.openai.com/v1/chat/completions"
MONITOR_AI_MODEL=""
MONITOR_AI_MAX_CALLS_PER_RUN="10"
# Official-domain replacement search: tavily or json (POST {query,domain,max_results}).
MONITOR_SEARCH_PROVIDER=""
MONITOR_SEARCH_API_KEY=""
MONITOR_SEARCH_ENDPOINT=""
MONITOR_SEARCH_MAX_CALLS_PER_RUN="3"

# Production account mail. Set credentials securely in Railway; never commit values.
EMAIL_PROVIDER=""
EMAIL_FROM=""
EMAIL_API_KEY=""
# Local logging is permitted only with APP_ENV=development/demo and EMAIL_PROVIDER=development.
# Optional anti-abuse check; required=true fails closed if either key is absent.
BOT_PROTECTION_REQUIRED="false"
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# No simulation unless explicitly enabled in a non-production environment.
MONITOR_ALLOW_SIMULATION="false"
