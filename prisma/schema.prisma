enum RequestStatus {
 OPEN
 ACCEPTED
 CANCELLED
}
enum BidStatus {
 SUBMITTED
 ACCEPTED
 WITHDRAWN
 DECLINED
}
model ReferralRequest {
 id String @id @default(cuid())
 userId String
 programId String
 desiredBountyCents Int
 notes String @default("")
