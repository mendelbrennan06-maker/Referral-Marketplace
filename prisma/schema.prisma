  id String @id @default(cuid())
  programId String
  variantId String?
  scopeKey String @default("PUBLIC")
  referrerRewardType RewardType @default(CASH)
  referrerRewardAmount Int?
  referrerRewardCurrency String @default("USD")
  estimatedReferrerValueCents Int?
  referredRewardType RewardType @default(CASH)
  referredRewardAmount Int?
  referredRewardCurrency String @default("USD")
